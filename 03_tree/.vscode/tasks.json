{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: 编译并运行 tree.cpp",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "chcp 65001>nul && C:\\msys64\\ucrt64\\bin\\g++.exe -std=c++11 -Wall -Wextra -g tree.cpp -o tree.exe && tree.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
